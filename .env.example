# Copy this file to .env in your production directory and fill in your values.
# Lines starting with # are comments and are ignored by launch.ps1.

# Transport mode: stdio or streamable-http
# Use streamable-http for a persistent server reachable over the network.
MCP_TRANSPORT=streamable-http

# SQLite database path, relative to the data\ folder in the production directory.
# The default is almost always correct -- uncomment only to override.
# INTERESTING_DB_PATH=data/interesting.db

# Comma-separated Host header values accepted in HTTP mode.
# Add your machine's hostname or Tailscale address if connecting remotely.
# INTERESTING_ALLOWED_HOSTS=localhost,127.0.0.1

# OAuth 2.0 credentials for HTTP mode.
# Both must be set to enable authentication; omit both to disable it.
# Generate strong random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERESTING_CLIENT_ID=
# INTERESTING_ACCESS_TOKEN=

# Base URL used as the OAuth issuer URL (default: http://localhost:8000).
# Override if the server is reachable at a different address.
# INTERESTING_BASE_URL=http://localhost:8000

# Maximum topics returned per roundup call. Must be a positive integer. Default: 6.
# INTERESTING_ROUNDUP_LIMIT=6
